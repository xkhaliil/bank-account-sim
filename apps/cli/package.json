{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line tool that shows accounts and makes withdrawals through the bank server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node .",
    "lint": "pnpm run \"/^lint-.*/\"",
    "lint-typecheck": "tsc",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "bank": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
