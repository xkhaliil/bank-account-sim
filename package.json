{
  "name": "bank-account-sim",
  "version": "0.1.0",
  "private": true,
  "description": "A bank account simulator: a server, a command-line tool and a web page that share one TypeScript library",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "start": "pnpm --filter cli start",
    "api": "pnpm --filter api dev",
    "web": "pnpm --filter web dev",
    "lint": "nx run-many -t lint",
    "lint-typecheck": "nx run-many -t lint-typecheck",
    "lint-eslint": "nx run-many -t lint-eslint",
    "lint-prettier": "nx run-many -t lint-prettier",
    "format": "nx run-many -t format"
  },
  "devDependencies": {
    "nx": "24.0.2"
  }
}
